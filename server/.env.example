# Development API only. Load variables in your shell; this file is not auto-loaded.
APP_PORT=8030
APP_DATABASE=server/.data/accounts.sqlite
# Generate a private random value of at least 32 bytes. Never commit it.
APP_PEPPER=
# Explicit demo transport: only @example.test; generated codes returned as devCode.
APP_DEV_MAIL=1
APP_EMAIL_DOMAINS=example.test
# Register an application before enabling real Yandex authorization.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://127.0.0.1:8030/api/auth/yandex/callback
# Optional delivery adapter, disabled until configured. Assess recipient domains and provider.
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
